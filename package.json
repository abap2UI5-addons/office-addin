{
  "name": "abap2ui5-office-addin",
  "private": true,
  "version": "0.1.0",
  "description": "abap2UI5 apps in Microsoft Excel: an Office add-in (task pane) that runs the real abap2UI5 UI5 frontend next to the workbook, with z2ui5.cc.ExcelBridge for reading and writing cells.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abap2UI5-addons/office-addin.git"
  },
  "bugs": {
    "url": "https://github.com/abap2UI5-addons/office-addin/issues"
  },
  "homepage": "https://github.com/abap2UI5-addons/office-addin#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "manifest": "node scripts/manifest.mjs",
    "bsp": "node scripts/build-bsp.mjs",
    "bsp:check": "node scripts/build-bsp.mjs --check",
    "dist": "node scripts/build-bsp.mjs --dist",
    "test": "node --test \"test/*.test.mjs\"",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,mjs,json,css}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json,css}\"",
    "abaplint": "abaplint ./abaplint.jsonc",
    "abaplint:cloud": "abaplint .github/abaplint/abap_cloud.jsonc",
    "abaplint:702": "abaplint .github/abaplint/abap_702.jsonc",
    "downport": "abaplint --fix .github/abaplint/abap_702.jsonc",
    "check:abap2ui5": "abap2ui5lint",
    "fmt:chains": "abap2ui5lint --fix",
    "e2e:build": "node test/e2e/build-backend.mjs",
    "e2e:serve": "node test/e2e/server.mjs",
    "e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm test && npm run bsp:check && npm run abaplint && npm run abaplint:cloud && npm run check:abap2ui5",
    "syfixes": "find src -type f -name '*.abap' -exec sed -i -e 's/ RAISE EXCEPTION TYPE cx_sy_itab_line_not_found/ ASSERT 1 = 0/g' {} +",
    "strip_trailing_ws": "find src -type f -name '*.abap' -exec sed -i 's/[[:space:]]\\+$//' {} +",
    "abaplintpathfix": "sed -i 's|\"/\\.\\./\\.\\./src/|\"/src/|g' abaplint.jsonc",
    "auto_downport": "(abaplint --fix .github/abaplint/abap_702.jsonc || true) && npm run syfixes && npm run strip_trailing_ws && abaplint .github/abaplint/abap_702.jsonc && cp -f .github/abaplint/abap_702.jsonc abaplint.jsonc && npm run abaplintpathfix",
    "deps:post": "npm run bsp",
    "site": "npm run build --prefix site",
    "site:dev": "npm run dev --prefix site"
  },
  "dependencies": {
    "@abap2ui5/embed-control": "0.3.0"
  },
  "devDependencies": {
    "@abap2ui5/linter": "^0.9.0",
    "@abap2ui5/node-runtime": "1.148.0",
    "@abaplint/cli": "^2.120.92",
    "@abaplint/transpiler-cli": "2.14.5",
    "@eslint/js": "^10.0.1",
    "@openui5/sap.m": "1.136.21",
    "@playwright/test": "1.64.1",
    "eslint": "^10.14.0",
    "express": "5.3.0",
    "globals": "^17.14.0",
    "office-addin-manifest": "3.0.1",
    "prettier": "^3.9.10",
    "ui5-1.71-sap.m": "npm:@openui5/sap.m@1.71.81"
  },
  "updateDeps": {
    "skip": {
      "@openui5/sap.m": "the UI5 1.136 of the smoke test, AGENTS.md Pins"
    }
  }
}
